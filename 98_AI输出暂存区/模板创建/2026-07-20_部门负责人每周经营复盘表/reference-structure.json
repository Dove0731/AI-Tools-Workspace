      "line_spacing": 1.15,
      "font_name": null,
      "font_size_pt": null,
      "bold": null
    },
    {
      "text": "四、团队与岗位观察",
      "style": "Normal",
      "alignment": null,
      "space_before_pt": 18.0,
      "space_after_pt": 4.0,
      "line_spacing": 1.15,
      "font_name": "Microsoft YaHei",

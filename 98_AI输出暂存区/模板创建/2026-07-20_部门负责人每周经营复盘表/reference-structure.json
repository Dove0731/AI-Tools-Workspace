      "font_size_pt": null,
      "bold": null
    },
    {
      "text": "五、机制沉淀与 AI 应用",
      "style": "Normal",
      "alignment": null,
      "space_before_pt": 18.0,
      "space_after_pt": 4.0,
      "line_spacing": 1.15,
